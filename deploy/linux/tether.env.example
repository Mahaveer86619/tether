# Copy to ~/tether/tether.env and chmod 600.
# Generate the token with: openssl rand -hex 32
TETHER_TOKEN=change-me

# Hub: listen on this machine's Tailscale IP (tailscale ip -4).
TETHER_ADDR=100.64.0.1:7420

# Agent: where the hub is, and the name this machine shows up as.
TETHER_HUB=ws://100.64.0.1:7420/ws
TETHER_NODE=minipc
