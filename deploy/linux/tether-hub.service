[Unit]
Description=Tether hub
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
EnvironmentFile=%h/tether/tether.env
ExecStart=%h/tether/bin/tether-hub -addr ${TETHER_ADDR} -db %h/tether/hub.db
Restart=always
# The Tailscale address may not exist yet right after boot.
RestartSec=5

[Install]
WantedBy=default.target
