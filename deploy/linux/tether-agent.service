[Unit]
Description=Tether agent
After=network-online.target tether-hub.service
Wants=network-online.target

[Service]
EnvironmentFile=%h/tether/tether.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/tether/bin/tether-agent -hub ${TETHER_HUB} -node ${TETHER_NODE}
Restart=always
RestartSec=5
# Let headless Claude runs finish their current write on stop.
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=default.target
