[Unit]
Description=Tether agent
After=network-online.target tether-hub.service
Wants=network-online.target

[Service]
EnvironmentFile=%h/tether/tether.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/tether/bin/tether-agent -hub ${TETHER_HUB} -node ${TETHER_NODE}
Restart=always
RestartSec=5
# Only stop the agent itself: the tmux server it starts holds your Claude
# sessions and must survive agent restarts and upgrades.
KillMode=process

[Install]
WantedBy=default.target
